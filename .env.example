# Copy this file to .env and adjust as needed. Never commit the real .env file.

# --- Application ---
APP_ENV=development
DEBUG=false

# --- CORS ---
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# --- PostgreSQL ---
# When running via `docker compose up`, POSTGRES_HOST is overridden to
# "postgres" automatically. These values also seed the Postgres container's
# own superuser/database on first boot.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny
POSTGRES_DB=lenny_growth_assistant

# --- LLM provider ---
# "ollama" (local, mandatory for the demo) or "cloud" (Anthropic Claude).
# Switching providers requires no code changes - see docs/architecture.md
# "Model provider abstraction".
LLM_PROVIDER=ollama
# 90s rather than Phase 3's 60s: Phase 4's grounding context (retrieved
# transcript excerpts folded into the system prompt) adds real prompt
# size, and measured end-to-end latency on CPU-only local inference for a
# grounded turn ran up to ~60s - see docs/architecture.md "Retrieval
# parameters".
MODEL_TIMEOUT_SECONDS=90
MAX_CONTEXT_MESSAGES=20

# --- Knowledge base retrieval (Phase 4) ---
KNOWLEDGE_TOP_K=4
KNOWLEDGE_MIN_RELEVANCE=0.5

# --- Ollama (used when LLM_PROVIDER=ollama) ---
# When running via `docker compose up`, OLLAMA_BASE_URL is overridden to
# "http://ollama:11434" automatically. See README "Pulling an Ollama model"
# for how to actually get OLLAMA_MODEL installed in the running container.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Cloud provider (used when LLM_PROVIDER=cloud) ---
# Anthropic Claude via the official `anthropic` Python SDK. Get a key at
# https://console.anthropic.com/ - never commit a real key here.
CLOUD_PROVIDER=anthropic
CLOUD_MODEL=claude-opus-5
CLOUD_API_KEY=

# --- Frontend ---
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=console
