# Copy this file to .env and adjust as needed. Never commit the real .env file.

# --- Application ---
APP_ENV=development
DEBUG=false

# --- CORS ---
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# --- PostgreSQL ---
# When running via `docker compose up`, POSTGRES_HOST is overridden to
# "postgres" automatically. These values also seed the Postgres container's
# own superuser/database on first boot.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny
POSTGRES_DB=lenny_growth_assistant

# --- Ollama ---
# When running via `docker compose up`, OLLAMA_BASE_URL is overridden to
# "http://ollama:11434" automatically.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Frontend ---
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=console
